# Copy to .env and fill in. Never commit .env.

# Only needed for the FX stage (https://openexchangerates.org/signup/free).
COFFEE_REVIEW_FOREX_API__API_KEY=replace-me

# Optional overrides (defaults live in src/coffee_review/config.py)
# COFFEE_REVIEW_COFFEE_SITE__RATE_PER_SEC=0.5
# COFFEE_REVIEW_LOG_LEVEL=DEBUG
# Reference-data sources (names from the registry in pipeline/reference.py)
# COFFEE_REVIEW_REFERENCE__FX_SOURCE=openexchangerates
# COFFEE_REVIEW_REFERENCE__CPI_SOURCE=bls
